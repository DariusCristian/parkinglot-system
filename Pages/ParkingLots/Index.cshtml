@page "{id:int?}"
@model ParkingLotSystem.Pages.ParkingLots.IndexModel

@{
    ViewData["Title"] = "Parking lots";
}

<h1>Parking lots</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Address</th>
            <th>City</th>
            <th>Capacity</th>
            <th>Hourly rate</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.ParkingLotData.ParkingLots)
        {
            string selectedRow = "";
            if (item.ID == Model.ParkingLotID)
            {
                selectedRow = "table-success";
            }

            <tr class="@selectedRow">
                <td>@item.Name</td>
                <td>@item.Address</td>
                <td>@item.City</td>
                <td>@item.Capacity</td>
                <td>@item.HourlyRate</td>
                <td>
                    <a asp-page="./Index" asp-route-id="@item.ID">Select</a> |
                    <a asp-page="./Edit" asp-route-id="@item.ID">Edit</a> |
                    <a asp-page="./Details" asp-route-id="@item.ID">Details</a> |
                    <a asp-page="./Delete" asp-route-id="@item.ID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.ParkingLotData.SubscriptionPlans != null && Model.ParkingLotData.SubscriptionPlans.Any())
{
    <h3>Subscription plans available in the selected parking lot</h3>

    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Monthly price</th>
                <th>Duration days</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var plan in Model.ParkingLotData.SubscriptionPlans)
            {
                <tr>
                    <td>@plan.Name</td>
                    <td>@plan.MonthlyPrice</td>
                    <td>@plan.DurationDays</td>
                </tr>
            }
        </tbody>
    </table>
}