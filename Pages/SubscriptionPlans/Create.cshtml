@page
@model ParkingLotSystem.Pages.SubscriptionPlans.CreateModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>SubscriptionPlan</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="SubscriptionPlan.Name" class="control-label"></label>
                <input asp-for="SubscriptionPlan.Name" class="form-control" aria-required="true"/>
                <span asp-validation-for="SubscriptionPlan.Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="SubscriptionPlan.MonthlyPrice" class="control-label"></label>
                <input asp-for="SubscriptionPlan.MonthlyPrice" class="form-control" />
                <span asp-validation-for="SubscriptionPlan.MonthlyPrice" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="SubscriptionPlan.DurationDays" class="control-label"></label>
                <input asp-for="SubscriptionPlan.DurationDays" class="form-control" />
                <span asp-validation-for="SubscriptionPlan.DurationDays" class="text-danger"></span>
            </div>
            <div class="form-group">
    <label class="control-label">Parking lots</label>
                <div>
                    <table>
                        <tr>
                            @{
                                int cnt = 0;
                                foreach (var lot in Model.AssignedParkingLotDataList)
                                {
                                    if (cnt++ % 3 == 0)
                                    {
                                        @:</tr><tr>
                                    }
                                    @:<td style="padding-right:20px;">
                                        <input type="checkbox"
                                               name="selectedParkingLots"
                                               value="@lot.ParkingLotID"
                                               @(lot.Assigned ? "checked=\"checked\"" : "") />
                                        @lot.Name
                                    @:</td>
                                }
                                @:</tr>
                            }
                    </table>
                </div>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
