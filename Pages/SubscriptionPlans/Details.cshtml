@page
@model ParkingLotSystem.Pages.SubscriptionPlans.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>SubscriptionPlan</h4>
    <hr />
    <dl class="row">
        <h4>Parking lots</h4>

        @if (Model.SubscriptionPlan.PlanParkingLots != null && Model.SubscriptionPlan.PlanParkingLots.Any())
        {
            <ul>
                @foreach (var pp in Model.SubscriptionPlan.PlanParkingLots)
                {
                    <li>@pp.ParkingLot?.Name</li>
                }
            </ul>
        }
        else
        {
            <p>No parking lots assigned.</p>
        }
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.SubscriptionPlan.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.SubscriptionPlan.Name)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.SubscriptionPlan.MonthlyPrice)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.SubscriptionPlan.MonthlyPrice)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.SubscriptionPlan.DurationDays)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.SubscriptionPlan.DurationDays)
        </dd>
    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.SubscriptionPlan.ID">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
